# ─────────────────────────────────────────────
# Enterprise Asset Management — Environment Config
# Copy this file to .env and fill in values.
# ─────────────────────────────────────────────

# Application
APP_NAME="Enterprise Asset Management"
API_VERSION="1.0.0"
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=changeme-use-a-strong-random-secret-key

# Database (not yet connected)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eam_db

# Supabase (not yet connected)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
